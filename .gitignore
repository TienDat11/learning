dist/

# dependencies
node_modules/

# local scratch / audit working dirs — large, never published
.scratch/

# scratch dumps from content work
.tmp-*
.c*.txt
.f*.txt

# python
venv/
.venv/
__pycache__/
*.pyc

# raw PNG originals for lesson images — the build embeds the optimised webp
# (see src/07-lesson-images.js and assets/images/webp/); 35 MB of raw source
# is not needed to publish or to rebuild.
assets/images/*.png

# Cloud-cost post-mortem SOURCE. It names the real GCP project, service, repos,
# digest tags, deploy files and API keys. The public repo carries the redacted
# page (cloud-cost-lessons-gcp-aws.html); this raw file stays local.
cloud-cost-lessons-gcp-aws.md

# headless-browser profiles created by render/verify runs — pure cache, never publish
edge-desk/
edge-mob/
edge-profile/
**/edge-desk/
**/edge-mob/
**/edge-profile/

# stray single-lesson dumps from content work
artifact_*.txt
